# Canopy accounts: who's signed in, and everyone's names and photos. Events
# keeps no names, emails or photos of its own, only person ids.
# Locally the account service runs on :3000; in production it's
# https://account.canopysf.com.
CANOPY_ACCOUNT_URL=http://localhost:3000
# The key from the account admin's Sites tab, for a site named "events"
# with "Allows quick (unverified) accounts" on. Shown once, when it's made.
CANOPY_ACCOUNT_KEY=cnp_xxxxxxxx

# What the account service signs its calendar requests with: in its
# Sites tab, give the "events" site a Calendar URL (http://localhost:3001
# locally) and Save, and it shows this once. Unset, events isn't in
# anyone's Canopy calendar. See README.md > Calendar.
# CANOPY_CALENDAR_SECRET=cnc_xxxxxxxx

# Where this service is, for the event links it hands out
# (<PUBLIC_URL>/e/<id>). Defaults to https://events.<CANOPY_DOMAIN> in
# production, and to the request's own address otherwise.
# PUBLIC_URL=https://events.canopysf.com

# The domain every Canopy site lives under: the Origin check uses it.
# CANOPY_DOMAIN=canopysf.com

# 3001 locally, so the account service can have 3000. The Dockerfile sets
# 3000 for Coolify.
PORT=3001
DATA_DIR=./data
